# Convex — run `npx convex dev` once, it will print/write this for you.
VITE_CONVEX_URL=

# Stripe — publishable key is safe for the client, secret key stays server-side.
VITE_STRIPE_PUBLISHABLE_KEY=
# Set on the Convex deployment, NOT in this file:
#   npx convex env set STRIPE_SECRET_KEY sk_test_...
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
#   npx convex env set STRIPE_MONTHLY_PRICE_ID price_...   # $19.99/mo recurring after the $1 trial
#   npx convex env set STRIPE_SIX_MONTH_PRICE_ID price_...  # expired-offer 6-month plan
#   npx convex env set STRIPE_TWELVE_MONTH_PRICE_ID price_... # expired-offer 12-month plan
#
# Checkout is a $1 PaymentIntent (card + Express wallets + Stripe PayPal).
# Enable Express Checkout / Apple Pay / Google Pay / PayPal on the Stripe
# account that owns these keys. Wallets often stay hidden on localhost.
# Optional, only if you add a standalone PayPal JS SDK (current button is Stripe PayPal):
# VITE_PAYPAL_CLIENT_ID=

# Meta Pixel (browser) + optional server-side Conversions API (CAPI) relay.
VITE_META_PIXEL_ID=
VITE_META_CAPI_ENABLED=false
# Set on the Convex deployment, NOT in this file:
#   npx convex env set META_PIXEL_ID <pixel-id>
#   npx convex env set META_ACCESS_TOKEN <capi-access-token>

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
