# Public — baked into the SPA at `npm run build` (Railway Variables before build).
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_META_PIXEL_ID=
VITE_META_CAPI_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server — runtime only. Never prefix these with VITE_.
# Local: copy to `.env` / `.env.local`. Railway: service Variables.
DATABASE_URL=postgres://user:pass@localhost:5432/successwise
SESSION_SECRET=change-me-at-least-16-chars
PORT=3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SIX_MONTH_PRICE_ID=
STRIPE_TWELVE_MONTH_PRICE_ID=

# OTP via Resend HTTPS (required in production). Without AUTH_RESEND_KEY, the API logs `[otp] email → code`.
AUTH_RESEND_KEY=
AUTH_EMAIL=MindoraAcademy.com <support@mindoraacademy.com>

# Optional: same pixel id as VITE_META_PIXEL_ID, plus CAPI token.
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Optional. Production `npm start` serves `./dist` automatically if index.html exists.
MARKETING_DIST=

# Optional. Public site origin for Stripe Customer Portal return URLs.
PUBLIC_ORIGIN=

# Optional. Wise LLM (otherwise canned coaching replies). Secrets stay runtime-only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WISE_MODEL=
