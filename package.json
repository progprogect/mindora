{
  "name": "successwise-quizzes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-lms-api.mjs && concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "node scripts/ensure-lms-api.mjs && tsx watch server/index.ts",
    "build": "npm run build:lms && tsc -p tsconfig.server.json && tsc -b && vite build",
    "build:lms": "node scripts/build-lms.mjs",
    "sync:authorisation": "node scripts/sync-authorisation.mjs",
    "dev:lms": "LMS_API_PROXY=http://localhost:3000 npm --prefix ./authorisation run dev",
    "start": "node server-dist/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/scripts/seed-products.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.3",
    "lucide-react": "^1.33.0",
    "pg": "^8.16.3",
    "posthog-js": "^1.418.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "resend": "^6.24.0",
    "stripe": "^19.1.0",
    "successwise-app": "file:./authorisation",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
