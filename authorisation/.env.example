# LMS Vite on :5175 proxies `/api` and `/stripe` → this package's API on :3001
# so the session cookie is same-origin. Do not point the proxy at github :3000.
# Secrets stay on the API — do not prefix them with VITE_.

# Separate Postgres from the github funnel DB (name or instance).
DATABASE_URL=postgres://user:pass@localhost:5432/successwise_lms
SESSION_SECRET=change-me-at-least-16-chars
PORT=3001

# Optional. OTP email (required in production). Without it, the API logs `[otp] email → code`.
AUTH_RESEND_KEY=
AUTH_EMAIL=SuccessWise.ai <onboarding@resend.dev>

# Optional. Add-on charges + Customer Portal. Trial checkout stays on github/.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Public origin for Stripe Customer Portal return URLs.
PUBLIC_ORIGIN=

# Optional. Production `npm start` serves `./dist` if index.html exists.
LMS_DIST=

# Optional. Wise LLM (canned replies if unset). Runtime only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WISE_MODEL=
